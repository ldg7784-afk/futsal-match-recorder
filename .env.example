# ============================================================================
# 환경변수 설정 예시 파일 (.env.example)
# ※ 실제 비밀키는 코드에 직접 하드코딩하지 말고 .env 파일 또는 배포 플랫폼(Vercel/Supabase) 환경변수에 설정하세요.
# ※ .env 파일은 .gitignore에 등록되어 있어 공개 저장소에 업로드되지 않습니다.
# ============================================================================

# 1. 관리형 데이터베이스 (Supabase 연동 시 사용)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. 교사용 운영 화면 접근 보호용 서명 해시 (코드 내 평문 비밀번호 하드코딩 금지)
TEACHER_TOKEN_HASH=TCHR-REPLACE-WITH-YOUR-SIGNED-HASH

# 3. 구글폼 응답이 연결된 구글시트 CSV 내보내기 URL (선택)
GOOGLE_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/YOUR_SHEET_ID/export?format=csv

